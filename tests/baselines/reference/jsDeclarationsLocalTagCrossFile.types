=== types.js ===
export {};

/**
 * @local
 * @typedef {{ x: number, y: number }} LocalPoint
 */

/**
 * @typedef {{ label: string }} PublicLabel
 */

/** @param {LocalPoint} p */
export function translate(p) {
>translate : (p: LocalPoint) => { x: number; y: number; }
>          : ^ ^^          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>p : LocalPoint
>  : ^^^^^^^^^^

    return { x: p.x + 1, y: p.y + 1 };
>{ x: p.x + 1, y: p.y + 1 } : { x: number; y: number; }
>                           : ^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>p.x + 1 : number
>        : ^^^^^^
>p.x : number
>    : ^^^^^^
>p : LocalPoint
>  : ^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^
>y : number
>  : ^^^^^^
>p.y + 1 : number
>        : ^^^^^^
>p.y : number
>    : ^^^^^^
>p : LocalPoint
>  : ^^^^^^^^^^
>y : number
>  : ^^^^^^
>1 : 1
>  : ^
}

